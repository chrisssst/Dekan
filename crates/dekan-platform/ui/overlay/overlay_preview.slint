import { Theme } from "../theme.slint";

export component ChromaPreview inherits Rectangle {
    in property <bool> preview-visible;
    in property <string> preview-name;
    in property <image> preview-image;
    in property <bool> preview-loading;
    in property <length> preview-anchor-x;
    in property <length> preview-anchor-y;
    in property <length> area-width;
    property <length> gap: 8px;
    property <length> rest: root.preview-anchor-y - self.height - self.gap < 6px ? root.preview-anchor-y + 19px + self.gap : root.preview-anchor-y - self.height - self.gap;
    visible: self.opacity > 0;
    opacity: root.preview-visible ? 1 : 0;
    animate opacity { duration: 120ms; easing: ease-out; }
    width: 148px;
    height: 178px;
    x: max(6px, min(root.preview-anchor-x - self.width / 2, root.area-width - self.width - 6px));
    y: root.preview-visible ? self.rest : self.rest + 3px;
    border-radius: 6px;
    border-width: 1px;
    border-color: Theme.gold-dim;
    background: Theme.card-fill;
    drop-shadow-blur: 22px;
    drop-shadow-offset-y: 8px;
    drop-shadow-color: #00000099;
    VerticalLayout {
        padding: 6px;
        spacing: 5px;
        Rectangle {
            height: self.width;
            border-radius: 4px;
            background: @radial-gradient(circle, Theme.card-hover 0%, Theme.bg-0 75%);
            clip: true;
            Image {
                width: 100%;
                height: 100%;
                source: root.preview-image;
                image-fit: contain;
                opacity: root.preview-loading ? 0.35 : 1;
            }
        }
        Text {
            text: root.preview-name;
            color: Theme.gold-bright;
            font-size: Theme.text-sm;
            horizontal-alignment: center;
            overflow: elide;
        }
    }
}
