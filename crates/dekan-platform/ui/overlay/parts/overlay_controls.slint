import { Theme } from "../../theme.slint";
import { ModLine } from "overlay_types.slint";

export component Tab inherits Rectangle {
    in property <string> text;
    in property <string> count;
    in property <bool> active;
    callback clicked();
    height: 30px;
    horizontal-stretch: 1;
    border-radius: 3px;
    border-width: 1px;
    border-color: root.active ? Theme.gold : touch.has-hover ? Theme.gold-dim : Theme.control-line;
    background: root.active ? #1a1912 : Theme.panel;
    animate border-color { duration: 120ms; }
    HorizontalLayout {
        alignment: center;
        spacing: 6px;
        Text {
            text: root.text.to-uppercase();
            color: root.active ? Theme.gold-bright : touch.has-hover ? Theme.text : Theme.muted;
            font-size: Theme.text-sm;
            font-weight: 700;
            letter-spacing: 1.2px;
            vertical-alignment: center;
        }
        if root.count != "": Rectangle {
            y: (parent.height - self.height) / 2;
            height: 16px;
            min-width: 16px;
            border-radius: 8px;
            background: Theme.gold-dim;
            HorizontalLayout {
                padding-left: 5px;
                padding-right: 5px;
                Text {
                    text: root.count;
                    color: Theme.gold-bright;
                    font-size: Theme.text-xs;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    accessible-role: tab;
    accessible-label: root.text;
    accessible-checkable: true;
    accessible-checked: root.active;
    accessible-action-default => { root.clicked(); }
}

export component ModEntry inherits Rectangle {
    in property <ModLine> line;
    callback clicked();
    min-height: 34px;
    border-radius: 3px;
    border-width: 1px;
    border-color: root.line.selected ? Theme.gold : touch.has-hover ? Theme.gold-dim : Theme.control-line;
    background: root.line.selected ? Theme.card-fill-selected : Theme.card-fill;
    Rectangle {
        x: 0;
        width: 2px;
        background: root.line.selected || touch.has-hover ? Theme.gold : Theme.line;
    }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 10px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 14px;
                height: 14px;
                border-width: 1px;
                border-color: root.line.selected ? Theme.gold : Theme.gold-dim;
                border-radius: root.line.radio ? 7px : 2px;
                background: Theme.bg-0;
                if root.line.selected: Rectangle {
                    x: 3px;
                    y: 3px;
                    width: 8px;
                    height: 8px;
                    border-radius: root.line.radio ? 4px : 1px;
                    background: Theme.gold;
                }
            }
        }
        Text {
            text: root.line.text;
            color: root.line.none ? Theme.muted : Theme.text;
            font-italic: root.line.none;
            font-size: Theme.text-base;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    accessible-role: checkbox;
    accessible-label: root.line.text;
    accessible-checkable: true;
    accessible-checked: root.line.selected;
    accessible-description: root.line.detail;
    accessible-action-default => { root.clicked(); }
}

export component HeaderButton inherits Rectangle {
    in property <string> label;
    in property <string> icon;
    callback clicked();
    width: 28px;
    border-radius: 4px;
    background: touch.has-hover ? Theme.gold.with-alpha(0.18) : transparent;
    animate background { duration: 120ms; }
    Path {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 11px;
        height: 11px;
        viewbox-width: 11;
        viewbox-height: 11;
        stroke: touch.has-hover ? Theme.gold-bright : Theme.muted;
        stroke-width: 1.4px;
        fill: transparent;
        commands: root.icon;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
}

export component PinButton inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    in property <bool> enabled: true;
    callback clicked();
    width: 30px;
    border-radius: 4px;
    border-width: 1px;
    border-color: root.active ? Theme.gold : touch.has-hover && root.enabled ? Theme.gold-dim : Theme.control-line;
    background: root.active ? Theme.gold.with-alpha(0.18) : Theme.panel;
    opacity: root.enabled ? 1 : 0.45;
    animate border-color { duration: 120ms; }
    Path {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 13px;
        height: 13px;
        viewbox-width: 13;
        viewbox-height: 13;
        stroke: root.active ? Theme.gold-bright : Theme.muted;
        stroke-width: 1.3px;
        fill: root.active ? Theme.gold : transparent;
        commands: "M 4 1 L 9 1 L 8 5 L 10.5 7.5 L 2.5 7.5 L 5 5 Z M 6.5 7.5 L 6.5 12.5";
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    accessible-role: button;
    accessible-label: root.label;
    accessible-checkable: true;
    accessible-checked: root.active;
    accessible-action-default => {
        if root.enabled {
            root.clicked();
        }
    }
}

export component Dice inherits Rectangle {
    in property <string> label;
    callback clicked();
    width: 34px;
    height: 34px;
    border-radius: 4px;
    border-width: 1px;
    border-color: touch.has-hover ? Theme.gold-dim : Theme.control-line;
    background: touch.pressed ? Theme.card : Theme.panel;
    animate border-color { duration: 150ms; }
    Path {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 18px;
        height: 18px;
        viewbox-width: 18;
        viewbox-height: 18;
        stroke: Theme.gold;
        stroke-width: 1.4px;
        fill: transparent;
        commands: "M 4 1 L 14 1 Q 17 1 17 4 L 17 14 Q 17 17 14 17 L 4 17 Q 1 17 1 14 L 1 4 Q 1 1 4 1 Z";
    }
    for pip in [{x: 5.5px, y: 5.5px}, {x: 12.5px, y: 5.5px}, {x: 9px, y: 9px}, {x: 5.5px, y: 12.5px}, {x: 12.5px, y: 12.5px}]: Rectangle {
        x: (parent.width - 18px) / 2 + pip.x - 1.5px;
        y: (parent.height - 18px) / 2 + pip.y - 1.5px;
        width: 3px;
        height: 3px;
        border-radius: 1.5px;
        background: Theme.gold;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
}
