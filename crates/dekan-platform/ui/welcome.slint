import { Theme, ExposeLayer, GoldButton, Diamond, Wordmark, Halo, Surface } from "theme.slint";

export component WelcomeWindow inherits Window {
    in property <bool> expose-flip;
    in property <string> version;
    in property <string> pill;
    in property <[string]> items;
    in property <string> dismiss-label;
    callback dismiss();
    property <bool> shown;
    title: "Dekan — League of Legends Skin Changer";
    icon: @image-url("assets/logo.png");
    preferred-width: 530px;
    preferred-height: 440px;
    min-width: 420px;
    min-height: 340px;
    background: Theme.backdrop;
    default-font-family: Theme.sans;
    forward-focus: keys;
    init => { root.shown = true; }

    keys := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape || event.text == Key.Return {
                root.dismiss();
                return accept;
            }
            reject
        }
    }

    content := VerticalLayout {
        y: root.shown ? 0px : 8px;
        opacity: root.shown ? 1 : 0;
        animate opacity, y { duration: 250ms; easing: ease-out; }
        padding-left: 28px;
        padding-right: 28px;
        padding-top: 22px;
        padding-bottom: 24px;
        spacing: 14px;
        Rectangle {
            height: 72px;
            Halo {
                x: -72px;
                y: -64px;
            }
            HorizontalLayout {
                spacing: 16px;
                Image {
                    source: @image-url("assets/logo-56.png");
                    width: 56px;
                    height: 56px;
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 5px;
                    Wordmark {
                        version: root.version;
                        size: 11px;
                    }
                    Text {
                        text: "League of Legends Skin Changer";
                        color: Theme.gold-bright;
                        font-family: Theme.serif;
                        font-size: 20px;
                        font-weight: 700;
                        overflow: elide;
                    }
                }
            }
        }
        Surface {
            vertical-stretch: 1;
            VerticalLayout {
                padding-top: 16px;
                padding-bottom: 16px;
                padding-left: 20px;
                padding-right: 20px;
                spacing: 9px;
                alignment: start;
                HorizontalLayout {
                    alignment: start;
                    padding-bottom: 3px;
                    Rectangle {
                        border-radius: 12px;
                        border-width: 1px;
                        border-color: Theme.cyan.with-alpha(0.25);
                        background: Theme.cyan.with-alpha(0.08);
                        HorizontalLayout {
                            padding-left: 7px;
                            padding-right: 10px;
                            padding-top: 3px;
                            padding-bottom: 3px;
                            spacing: 7px;
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 6px;
                                    height: 6px;
                                    border-radius: 3px;
                                    background: Theme.cyan;
                                    drop-shadow-blur: 4px;
                                    drop-shadow-color: Theme.cyan;
                                }
                            }
                            Text {
                                text: root.pill;
                                color: Theme.cyan;
                                font-size: Theme.text-sm;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
                for item in root.items: HorizontalLayout {
                    spacing: 10px;
                    VerticalLayout {
                        padding-top: 4px;
                        Diamond { }
                    }
                    Text {
                        text: item;
                        color: Theme.text;
                        font-size: Theme.text-base;
                        wrap: word-wrap;
                        horizontal-stretch: 1;
                    }
                }
            }
        }
        HorizontalLayout {
            alignment: center;
            GoldButton {
                width: 230px;
                min-height: 40px;
                horizontal-stretch: 0;
                primary: true;
                font-size: Theme.text-base;
                text: root.dismiss-label;
                clicked => { root.dismiss(); }
            }
        }
    }

    ExposeLayer {
        flip: root.expose-flip;
    }
}
