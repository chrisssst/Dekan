import { Theme, GoldButton, Switch, Surface, CheckGlyph } from "../theme.slint";
import { PanelCheckRow } from "panel_types.slint";

export component Section inherits Surface {
    in property <string> heading;
    border-radius: 14px;
    VerticalLayout {
        padding-top: 14px;
        padding-bottom: 14px;
        padding-left: 16px;
        padding-right: 16px;
        spacing: 10px;
        if root.heading != "": Text {
            text: root.heading;
            color: Theme.gold;
            font-size: Theme.text-sm;
            font-weight: 700;
            letter-spacing: 0.6px;
        }
        @children
    }
}

export component PanelTab inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> active;
    in property <int> badge;
    callback clicked();
    property <bool> focused: keys.has-focus;
    min-width: row.preferred-width + 16px;
    horizontal-stretch: 1;
    height: 36px;
    border-radius: 9px;
    border-width: root.focused ? 2px : 0px;
    border-color: Theme.gold-bright;
    row := HorizontalLayout {
        alignment: center;
        spacing: 6px;
        padding-left: 8px;
        padding-right: 8px;
        if root.icon != "": VerticalLayout {
            alignment: center;
            Path {
                width: 13px;
                height: 13px;
                viewbox-width: 16;
                viewbox-height: 16;
                stroke: root.active ? Theme.gold-bright : touch.has-hover ? Theme.text : Theme.muted;
                stroke-width: 1.5px;
                fill: transparent;
                commands: root.icon;
                animate stroke { duration: 150ms; }
            }
        }
        Text {
            text: root.text;
            color: root.active ? Theme.gold-bright : touch.has-hover ? Theme.text : Theme.muted;
            font-size: Theme.text-md;
            font-weight: root.active ? 700 : 500;
            vertical-alignment: center;
            animate color { duration: 150ms; }
        }
        if root.badge > 0: VerticalLayout {
            alignment: center;
            Rectangle {
                min-width: 16px;
                height: 16px;
                border-radius: 8px;
                background: Theme.danger;
                Text {
                    text: root.badge;
                    color: #ffffff;
                    font-size: 10px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
    keys := FocusScope {
        key-pressed(event) => {
            if event.text == " " || event.text == Key.Return {
                root.clicked();
                return accept;
            }
            reject
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    accessible-role: tab;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }
}

export component CheckRow inherits Rectangle {
    in property <PanelCheckRow> check;
    border-radius: 9px;
    background: root.check.ok ? #0f1927 : #24151a;
    border-width: 1px;
    border-color: root.check.ok ? #1f2e42 : #5a2a30;
    HorizontalLayout {
        padding-top: 9px;
        padding-bottom: 9px;
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;
        VerticalLayout {
            alignment: start;
            padding-top: 4px;
            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: root.check.ok ? Theme.cyan : Theme.danger;
                drop-shadow-blur: 4px;
                drop-shadow-color: root.check.ok ? Theme.cyan.with-alpha(0.55) : Theme.danger.with-alpha(0.55);
            }
        }
        VerticalLayout {
            alignment: start;
            spacing: 2px;
            Text {
                text: root.check.label;
                color: Theme.text;
                font-size: Theme.text-base;
                font-weight: 600;
                wrap: word-wrap;
            }
            Text {
                text: root.check.detail;
                color: root.check.ok ? Theme.muted : Theme.danger-text;
                font-size: Theme.text-sm;
                wrap: word-wrap;
            }
        }
    }
}

export component Toggle inherits Rectangle {
    in property <string> label;
    in property <string> hint;
    in property <bool> checked;
    in property <bool> divider: true;
    callback toggled();
    property <bool> focused: keys.has-focus;
    border-radius: 10px;
    border-width: root.focused ? 2px : 0px;
    border-color: Theme.gold-bright;
    background: touch.has-hover ? #ffffff09 : #ffffff00;
    animate background { duration: 130ms; }
    VerticalLayout {
        if root.divider: Rectangle {
            height: 1px;
            background: Theme.surface-line;
        }
        HorizontalLayout {
            padding-top: 11px;
            padding-bottom: 11px;
            padding-left: 6px;
            padding-right: 6px;
            spacing: 14px;
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                Text {
                    text: root.label;
                    color: Theme.text;
                    font-size: Theme.text-base;
                    font-weight: 600;
                    wrap: word-wrap;
                }
                if root.hint != "": Text {
                    text: root.hint;
                    color: Theme.muted;
                    font-size: Theme.text-sm;
                    wrap: word-wrap;
                }
            }
            VerticalLayout {
                alignment: center;
                Switch {
                    checked: root.checked;
                }
            }
        }
    }
    keys := FocusScope {
        key-pressed(event) => {
            if event.text == " " || event.text == Key.Return {
                root.toggled();
                return accept;
            }
            reject
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggled(); }
    }
    accessible-role: switch;
    accessible-label: root.label;
    accessible-description: root.hint;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-action-default => { root.toggled(); }
}

export component PowerCard inherits Rectangle {
    in property <string> label;
    in property <string> hint;
    in property <bool> checked;
    callback toggled();
    property <bool> focused: keys.has-focus;
    border-radius: 14px;
    border-width: root.focused ? 2px : 1px;
    border-color: root.focused ? Theme.gold-bright : root.checked ? Theme.gold-dim : Theme.surface-line;
    background: root.checked ? Theme.card-fill-selected : Theme.card-fill;
    animate border-color { duration: 200ms; }
    Rectangle {
        x: 0;
        y: 16px;
        width: 3.5px;
        height: parent.height - 32px;
        border-radius: 2px;
        background: root.checked ? Theme.gold : Theme.control-line;
        animate background { duration: 180ms; }
    }
    HorizontalLayout {
        padding-top: 18px;
        padding-bottom: 18px;
        padding-left: 20px;
        padding-right: 18px;
        spacing: 16px;
        VerticalLayout {
            alignment: center;
            spacing: 4px;
            Text {
                text: root.label;
                color: Theme.gold-bright;
                font-family: Theme.serif;
                font-size: 17px;
                font-weight: 700;
                wrap: word-wrap;
            }
            Text {
                text: root.hint;
                color: Theme.muted;
                font-size: Theme.text-sm;
                wrap: word-wrap;
            }
        }
        VerticalLayout {
            alignment: center;
            Switch {
                large: true;
                checked: root.checked;
            }
        }
    }
    keys := FocusScope {
        key-pressed(event) => {
            if event.text == " " || event.text == Key.Return {
                root.toggled();
                return accept;
            }
            reject
        }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggled(); }
    }
    accessible-role: switch;
    accessible-label: root.label;
    accessible-description: root.hint;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-action-default => { root.toggled(); }
}

export component AllClearBanner inherits Rectangle {
    in property <string> text;
    border-radius: 12px;
    border-width: 1px;
    border-color: #194545;
    background: #0d1e24;
    HorizontalLayout {
        padding-top: 11px;
        padding-bottom: 11px;
        padding-left: 14px;
        padding-right: 14px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 20px;
                height: 20px;
                border-radius: 10px;
                background: Theme.cyan.with-alpha(0.18);
                CheckGlyph {
                    x: 5px;
                    y: 5px;
                    stroke: Theme.cyan;
                }
            }
        }
        Text {
            text: root.text;
            color: Theme.text;
            font-size: Theme.text-base;
            wrap: word-wrap;
            vertical-alignment: center;
        }
    }
}

export component Notice inherits Rectangle {
    in property <string> line;
    in property <string> action;
    in property <bool> warning;
    callback activated();
    border-radius: 12px;
    border-width: 1px;
    border-color: root.warning ? Theme.danger : Theme.gold-dim;
    background: root.warning ? Theme.danger.with-alpha(0.15) : Theme.card-fill;
    Rectangle {
        x: 0;
        y: 10px;
        width: 3px;
        height: parent.height - 20px;
        border-radius: 1.5px;
        background: root.warning ? Theme.danger : Theme.gold;
    }
    HorizontalLayout {
        padding-top: 12px;
        padding-bottom: 12px;
        padding-left: 16px;
        padding-right: 14px;
        spacing: 12px;
        Text {
            text: root.line;
            color: Theme.gold-bright;
            font-size: Theme.text-base;
            wrap: word-wrap;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        if root.action != "": VerticalLayout {
            alignment: center;
            GoldButton {
                text: root.action;
                primary: !root.warning;
                hug: true;
                horizontal-stretch: 0;
                clicked => { root.activated(); }
            }
        }
    }
}
