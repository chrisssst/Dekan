import { Theme, CheckGlyph } from "../theme.slint";

export component RepairBanner inherits Rectangle {
    in property <int> state;
    in property <string> text;
    property <float> phase: mod(animation-tick() / 1100ms, 1.0);
    border-radius: 10px;
    border-width: 1px;
    border-color: root.state == 3 ? Theme.danger : root.state == 2 ? Theme.cyan : Theme.gold-dim;
    background: root.state == 3 ? Theme.danger.with-alpha(0.15) : root.state == 2 ? Theme.surface : Theme.card;
    VerticalLayout {
        padding-top: 10px;
        padding-bottom: 10px;
        padding-left: 12px;
        padding-right: 12px;
        spacing: 8px;
        HorizontalLayout {
            spacing: 10px;
            alignment: start;
            if root.state == 2: VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 18px;
                    height: 18px;
                    border-radius: 9px;
                    background: Theme.cyan.with-alpha(0.2);
                    CheckGlyph {
                        x: 4px;
                        y: 4px;
                        stroke: Theme.cyan;
                    }
                }
            }
            if root.state != 2: VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: root.state == 3 ? Theme.danger : Theme.gold;
                }
            }
            Text {
                text: root.text;
                color: root.state == 3 ? Theme.danger-text : root.state == 2 ? Theme.text : Theme.gold-bright;
                font-size: Theme.text-sm;
                font-weight: 500;
                wrap: word-wrap;
                horizontal-stretch: 1;
            }
        }
        if root.state == 1: Rectangle {
            height: 4px;
            border-radius: 2px;
            background: Theme.surface-line;
            clip: true;
            Rectangle {
                width: parent.width * 0.36;
                height: parent.height;
                border-radius: 2px;
                x: (parent.width + self.width) * root.phase - self.width;
                background: @linear-gradient(90deg, Theme.gold-dim 0%, Theme.gold-bright 50%, Theme.cyan 100%);
            }
        }
    }
}
