export global Theme {
    in-out property <int> mode: 1;

    out property <color> bg-0: mode == 0 ? #05080c : mode == 1 ? #080508 : #07070a;
    out property <color> bg-1: mode == 0 ? #0a1428 : mode == 1 ? #140914 : #0c0b10;
    out property <color> bg-2: mode == 0 ? #0e1c2e : mode == 1 ? #1c0b1a : #121019;

    out property <color> panel: mode == 0 ? #10161f : mode == 1 ? #1a1018 : #111015;
    out property <color> card: mode == 0 ? #1a2230 : mode == 1 ? #291426 : #19171f;
    out property <color> card-hover: mode == 0 ? #202a3b : mode == 1 ? #351a31 : #211e29;

    out property <color> line: mode == 0 ? #2a3542 : mode == 1 ? #4a2942 : #312d3a;
    out property <color> line-gold: mode == 0 ? #4a3d22 : mode == 1 ? #5e243f : #4b405f;

    out property <color> gold: mode == 0 ? #c8aa6e : mode == 1 ? #e45b9d : #8f80b8;
    out property <color> gold-bright: mode == 0 ? #f0e6d2 : mode == 1 ? #fff0f7 : #f0edf7;
    out property <color> gold-dim: mode == 0 ? #785a28 : mode == 1 ? #9b315f : #5f537a;

    out property <color> cyan: mode == 0 ? #0ac8b9 : mode == 1 ? #ff4f9b : #9b8bd1;

    out property <color> text: mode == 0 ? #f0e6d2 : mode == 1 ? #fff0f7 : #eeebf2;
    out property <color> muted: mode == 0 ? #a09b8c : mode == 1 ? #c2a7b7 : #aaa4b2;
    out property <color> muted-dim: mode == 0 ? #85817a : mode == 1 ? #947b89 : #7f7988;

    out property <color> control-line: mode == 0 ? #5a6a82 : mode == 1 ? #70405f : #4a4652;
    out property <color> button-line: mode == 0 ? #9b7b45 : mode == 1 ? #bd4c83 : #655879;

    out property <color> danger: mode == 0 ? #c8aa6e : mode == 1 ? #d8587e : #8f80b8;
    out property <color> danger-text: mode == 0 ? #f0e6d2 : mode == 1 ? #fff0f7 : #f0edf7;

    out property <color> surface: mode == 0 ? #141c28 : mode == 1 ? #21101e : #16141b;
    out property <color> surface-hover: mode == 0 ? #1a2436 : mode == 1 ? #2c1428 : #201c27;
    out property <color> surface-line: mode == 0 ? #243040 : mode == 1 ? #4a203e : #322c3e;

    out property <color> button: mode == 0 ? #0f1622 : mode == 1 ? #1c0b19 : #121016;
    out property <color> input: mode == 0 ? #09121d : mode == 1 ? #120711 : #0b0a0d;

    out property <brush> backdrop:
        mode == 0
            ? @linear-gradient(180deg, #0a1428 0%, #070d18 45%, #05080c 100%)
            : mode == 1
                ? @linear-gradient(180deg, #140914 0%, #0e070d 45%, #080508 100%)
                : @linear-gradient(180deg, #0c0b10 0%, #09080c 45%, #07070a 100%);

    out property <brush> header:
        mode == 0
            ? @linear-gradient(180deg, #0e1c2e 0%, #10161f 100%)
            : mode == 1
                ? @linear-gradient(180deg, #1c0b1a 0%, #1a1018 100%)
                : @linear-gradient(180deg, #16121c 0%, #111015 100%);

    out property <brush> card-fill:
        mode == 0
            ? @linear-gradient(180deg, #1a2230 0%, #10161f 100%)
            : mode == 1
                ? @linear-gradient(180deg, #291426 0%, #1a1018 100%)
                : @linear-gradient(180deg, #201c27 0%, #111015 100%);

    out property <brush> card-fill-hover:
        mode == 0
            ? @linear-gradient(180deg, #202a3b 0%, #10161f 100%)
            : mode == 1
                ? @linear-gradient(180deg, #351a31 0%, #1a1018 100%)
                : @linear-gradient(180deg, #2a2533 0%, #16141b 100%);

    out property <brush> card-fill-selected:
        mode == 0
            ? @linear-gradient(180deg, #2c2a25 0%, #1a2230 100%)
            : mode == 1
                ? @linear-gradient(180deg, #3a1830 0%, #291426 100%)
                : @linear-gradient(180deg, #2c2634 0%, #19171f 100%);

    out property <string> sans: "Segoe UI";
    out property <string> serif: "Georgia";

    out property <length> text-xs: 10px;
    out property <length> text-sm: 11px;
    out property <length> text-md: 12px;
    out property <length> text-base: 13px;
    out property <length> text-lg: 15px;
    out property <length> text-xl: 22px;
}

export component ExposeLayer inherits Rectangle {
    in property <bool> flip;
    background: root.flip ? #00000001 : #00000000;
}

export component Hairline inherits Rectangle {
    in property <bool> gold;
    height: 1px;
    background: root.gold ? Theme.gold-dim : Theme.line-gold;
}

export component Caps inherits Text {
    color: Theme.gold;
    font-size: Theme.text-xs;
    font-weight: 700;
    letter-spacing: 1.5px;
}

export component Wordmark inherits HorizontalLayout {
    in property <string> version;
    in property <length> size: 15px;
    spacing: 6px;
    alignment: start;
    Text {
        text: "DEKAN";
        font-family: Theme.serif;
        font-size: root.size;
        font-weight: 700;
        letter-spacing: root.size * 0.14;
        color: Theme.gold-bright;
        vertical-alignment: center;
    }
    Text {
        text: "v" + root.version;
        font-size: Theme.text-xs;
        font-weight: 600;
        letter-spacing: 0.4px;
        color: Theme.gold;
        vertical-alignment: center;
    }
}

export component StatusDot inherits Rectangle {
    in property <bool> online: true;
    width: 7px;
    height: 7px;
    border-radius: 3.5px;
    background: root.online ? Theme.cyan : Theme.muted-dim;
    drop-shadow-blur: root.online ? 5px : 0;
    drop-shadow-color: Theme.cyan;
}

export component GoldButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <bool> primary;
    in property <bool> danger;
    in property <bool> caps;
    in property <length> font-size: Theme.text-md;
    in property <length> tracking: 0px;
    callback clicked();
    property <bool> hot: touch.has-hover && root.enabled;
    property <bool> focused: keys.has-focus && root.enabled;
    min-height: 32px;
    vertical-stretch: 0;
    horizontal-stretch: 1;
    border-radius: 6px;
    border-width: root.focused ? 2px : 1px;
    border-color: !root.enabled ? Theme.control-line : root.focused ? Theme.gold-bright : root.primary ? (root.hot ? Theme.gold-bright : Theme.gold) : root.danger ? (root.hot ? Theme.gold-bright : Theme.danger) : root.hot ? Theme.gold : Theme.button-line;
    background: root.primary ? (touch.pressed ? Theme.gold-dim : root.hot ? Theme.gold-bright : Theme.gold) : root.danger ? Theme.danger.with-alpha(root.hot ? 0.32 : 0.20) : touch.pressed ? Theme.card : root.hot ? Theme.surface-hover : Theme.button;
    drop-shadow-blur: root.primary ? (root.hot ? 12px : 6px) : 0px;
    drop-shadow-color: Theme.gold.with-alpha(root.hot ? 0.45 : 0.25);
    opacity: root.enabled ? 1 : 0.45;
    animate border-color, drop-shadow-blur { duration: 150ms; }
    Text {
        x: 12px;
        y: touch.pressed && root.enabled ? 1px : 0px;
        width: parent.width - 24px;
        height: parent.height;
        text: root.caps ? root.text.to-uppercase() : root.text;
        color: root.primary ? Theme.bg-0 : root.danger ? Theme.danger-text : Theme.gold-bright;
        font-family: Theme.sans;
        font-size: root.font-size;
        font-weight: root.caps || root.primary ? 700 : 600;
        letter-spacing: root.tracking;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
    keys := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == " " || event.text == Key.Return {
                root.clicked();
                return accept;
            }
            reject
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled {
            root.clicked();
        }
    }
}

export component Switch inherits Rectangle {
    in property <bool> checked;
    width: 36px;
    height: 20px;
    border-radius: 10px;
    border-width: 0;
    background: root.checked ? Theme.gold-dim : Theme.control-line;
    animate background { duration: 150ms; }
    Rectangle {
        y: 3px;
        x: root.checked ? root.width - self.width - 3px : 3px;
        width: 14px;
        height: 14px;
        border-radius: 7px;
        background: root.checked ? Theme.gold-bright : Theme.muted;
        animate x { duration: 150ms; easing: ease-out; }
    }
}

export component Diamond inherits Text {
    text: "◆";
    color: Theme.gold;
    font-size: 9px;
    vertical-alignment: top;
}

export component SearchGlyph inherits Path {
    width: 13px;
    height: 13px;
    viewbox-width: 13;
    viewbox-height: 13;
    stroke: Theme.muted-dim;
    stroke-width: 1.4px;
    fill: transparent;
    commands: "M 5.5 1 A 4.5 4.5 0 1 1 5.49 1 Z M 8.8 8.8 L 12 12";
}

export component Field inherits Rectangle {
    in property <string> placeholder;
    in property <bool> read-only;
    in property <bool> search-icon;
    in property <bool> monospace;
    in property <length> trailing: 0px;
    in-out property <string> text;
    out property <bool> has-focus: input.has-focus;
    callback accepted();
    callback cancelled();
    callback edited();
    callback focus-requested();
    min-height: 38px;
    vertical-stretch: 0;
    clip: true;
    border-radius: 4px;
    border-width: 1px;
    border-color: input.has-focus ? Theme.gold : Theme.control-line;
    background: root.monospace ? Theme.input : Theme.bg-0;
    drop-shadow-blur: input.has-focus ? 10px : 0px;
    drop-shadow-color: Theme.gold.with-alpha(0.25);
    animate border-color, drop-shadow-blur { duration: 200ms; }
    if root.search-icon: SearchGlyph {
        x: 11px;
        y: (parent.height - self.height) / 2;
    }
    Text {
        x: input.x;
        visible: root.text == "";
        text: root.placeholder;
        color: Theme.muted-dim;
        font-family: Theme.sans;
        font-size: input.font-size;
        vertical-alignment: center;
        height: parent.height;
    }
    input := TextInput {
        x: root.search-icon ? 32px : 12px;
        width: parent.width - self.x - 12px - root.trailing;
        height: parent.height;
        text <=> root.text;
        read-only: root.read-only;
        color: root.monospace ? Theme.gold-bright : Theme.text;
        font-family: root.monospace ? "Consolas" : Theme.sans;
        font-size: Theme.text-base;
        vertical-alignment: center;
        single-line: true;
        selection-background-color: Theme.gold-dim;
        selection-foreground-color: Theme.gold-bright;
        accepted => { root.accepted(); }
        edited => { root.edited(); }
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.cancelled();
                return accept;
            }
            reject
        }
        changed has-focus => {
            if self.has-focus {
                root.focus-requested();
            }
        }
    }
    @children
    public function take-focus() {
        input.focus();
    }
    public function select-all() {
        input.select-all();
    }
    public function release-focus() {
        input.clear-focus();
    }
}
