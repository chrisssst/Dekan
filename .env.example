# Dekan environment variables — reference only.
#
# Dekan does not load a .env file: it reads these from the Windows environment when it starts. Every one
# is optional; leave them unset for the normal behavior. To set one:
#
#   PowerShell, this session only:   $env:DEKAN_LOG = "debug"; & "C:\Program Files\Dekan\dekan.exe"
#   Permanently, for your user:      setx DEKAN_LOG debug        (then restart Dekan)
#   To remove it again:              [Environment]::SetEnvironmentVariable("DEKAN_LOG", $null, "User")
#
# Never put secrets here; none of these variables is one.

# Log detail written to %LOCALAPPDATA%\Dekan\logs.
# info (default) | debug | trace, or a filter such as dekan_lcu=trace. Overrides RUST_LOG.
# debug also makes the injector host log its own details.
DEKAN_LOG=info

# Party relay to use instead of the built-in default. Must be wss:// (ws:// is accepted only for
# 127.0.0.1 / localhost while testing a local relay). Takes precedence over party.json.
# DEKAN_RELAY_URL=wss://your-relay.example.workers.dev

# Download a skin library in the background from a GitHub repository you choose, as owner/repo.
# Off when unset; Dekan has no built-in source.
# DEKAN_SKIN_SYNC=owner/repo

# Check GitHub for a newer Dekan release every few hours and announce it once (nothing is downloaded).
# On when unset; 0, off, false or no turns it off.
# DEKAN_UPDATE_CHECK=0

# Advanced: numeric hook flags passed to the injector host (bit field). Leave unset unless you are
# diagnosing the injector. Default: 4.
# DEKAN_PATCHER_FLAGS=4

# Testing only: move each skin's own animation graph into slot 0 instead of reaching it through its link.
# DEKAN_SKIN_GRAPH=slot0

# Testing only: a chroma loaded as the default skin keeps its own classification instead of the slot's.
# DEKAN_CHROMA_CLASSIFICATION=source
