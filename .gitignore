# Rust build artifacts
/target/
**/*.rs.bk
*.pdb

# Editors and IDEs
.idea/
.vscode/
.vs/
*.swp
*.swo

# OS files
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/
.DS_Store

# Build and packaging output (`cargo xtask package` / `installer`)
/dist/
/installer/Output/

# Binaries are built or supplied by the user, never versioned
*.exe
*.dll

# Game data and mods (large, copyrighted, or generated per patch)
hashes.game.txt
*.wad.client
*.fantome

# Runtime logs
*.log
*.log.*

# Icon pipeline intermediates (only assets/dekan.ico, dekan.png and the conversion script are versioned)
assets/upscalemedia-*.png
assets/ico.png
assets/debug_frame_*.png
assets/test_gdi_rendered.png
assets/golden_*.png

# Party relay
relay-worker/node_modules/
relay-worker/.wrangler/
relay-worker/.dev.vars

# Secrets and signing material
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# Local AI and agent context (kept private; CLAUDE.md and AGENTS.md are the public entry points).
# No exceptions: internal skills and notes never ship with the public repository.
.claude/
.agents/
CLAUDE.local.md
graphify-out/

# Local diagnostics, sessions and scratch files
vanguard_logs_*/
logs_*/
sessoes/
META/
registro.txt
fontes_base.txt
report_user.txt
ESTADO_PROJETO.md
SESSION_*.md
strip_rust_comments.py

# Python cache
__pycache__/
*.pyc
.mypy_cache/
resultados_ltk/
